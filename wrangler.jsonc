{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devalon-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "vars": {
    "META_GRAPH_API_VERSION": "v27.0",
    "META_GRAPH_API_BASE_URL": "https://graph.facebook.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
