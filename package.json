{
  "name": "@devalon.dev/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono API server on Cloudflare Workers backed by Kysely and Turso (libSQL)",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "migration:create": "tsx src/scripts/migration-create.ts",
    "migration:run": "tsx src/scripts/migration-run.ts"
  },
  "dependencies": {
    "@libsql/kysely-libsql": "^0.4.1",
    "dotenv": "^18.0.10",
    "hono": "^4.13.21",
    "kysely": "^0.29.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.167.0"
  }
}
